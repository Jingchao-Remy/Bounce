@app.route("/api/status")
def api_status():
    return jsonify(get_status())


@app.route("/api/switch", methods=["POST"])
def api_switch():
    data = request.get_json()
    provider_id = data.get("provider_id", "")
    result = do_switch(provider_id)
    return jsonify(result)


@app.route("/api/test")
def api_test():
    config = load_config()
    active_id = config.get("active_provider", "")
    result = test_provider(active_id)
    return jsonify(result)


@app.route("/api/providers")
def api_providers():
    config = load_config()
    return jsonify(config["providers"])


# ── CLI Entry Point ──────────────────────────────────────────────────────

def main():
    port = 3000
    daemon = False
    
    args = sys.argv[1:]
    for i, arg in enumerate(args):
        if arg == "--port" and i + 1 < len(args):
            port = int(args[i + 1])
        elif arg == "--daemon":
            daemon = True
    
    if daemon:
        import multiprocessing
        p = multiprocessing.Process(target=lambda: app.run(host="0.0.0.0", port=port, debug=False))
        p.daemon = True
        p.start()
        print(f"✅ Bounce Panel 已后台启动: http://localhost:{port}")
        print(f"   停止: kill {p.pid}")
    else:
        print(f"⚡ Bounce Panel: http://localhost:{port}")
        print(f"   按 Ctrl+C 停止")
        app.run(host="0.0.0.0", port=port, debug=False)


if __name__ == "__main__":
    main()