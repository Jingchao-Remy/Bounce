Bounce — Web Management Panel (Phase 2)
Flask-based web UI for managing model providers.

Usage:
  bounce-panel            # Start the web panel (default port 3000)
  bounce-panel --port 8080
  bounce-panel --daemon   # Start in background
"""

import os
import sys
import json
import subprocess
import threading
import webbrowser
