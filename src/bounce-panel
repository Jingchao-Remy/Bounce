# ── Config ──────────────────────────────────────────────────────────────
CONFIG_DIR = os.path.expanduser("~/.bounce")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
# WSL <-> Windows integration
def _get_win_user():
    """Get the current Windows username for WSL path resolution."""
    users_dir = "/mnt/c/Users"
    if os.path.exists(users_dir):
        for u in sorted(os.listdir(users_dir)):
            if u not in (".", "..", "All Users", "Default", "Default User", "Public"):
                full = os.path.join(users_dir, u)
                if os.path.isdir(full) and not os.path.islink(full):
                    return full
    return os.path.expanduser("~")
WIN_USER_HOME = _get_win_user()
WINDOWS_ENV_DIR = os.path.join(WIN_USER_HOME, ".bounce")

# Check HOME redirect (Hermes quirk)
real_home = os.environ.get("HOME", os.path.expanduser("~"))
alt_config = os.path.join(real_home, ".bounce", "config.json")
if not os.path.exists(CONFIG_PATH) and os.path.exists(alt_config):
    CONFIG_DIR = os.path.join(real_home, ".bounce")
    CONFIG_PATH = alt_config

# ── Data Layer ──────────────────────────────────────────────────────────

def load_config():
    with open(CONFIG_PATH) as f:
        return json.load(f)

def save_config(config):
    with open(CONFIG_PATH, "w") as f:
        json.dump(config, f, indent=2, ensure_ascii=False)

def resolve(config, provider_id, key_path):
    provider = next((p for p in config["providers"] if p["id"] == provider_id), None)
    if not provider:
        return None
    parts = key_path.split(".")
    val = provider
    for part in parts:
        if isinstance(val, dict):
            val = val.get(part)
        else:
            return None
    return val

def get_env_for_provider(config, provider_id):
    env = {}
    tool = config["tools"]["claude_code"]
    for env_var, key_path in tool["env_map"].items():
        val = resolve(config, provider_id, key_path)
        if val:
            env[env_var] = str(val)
    return env

def write_env_files(config, provider_id):
    """Write env files for both WSL and Windows."""
    env = get_env_for_provider(config, provider_id)
    
    # WSL shell env
    shell_path = os.path.join(CONFIG_DIR, "current.sh")
    with open(shell_path, "w") as f:
        f.write(f"# Bounce — Current provider: {provider_id}\n")
        for k, v in env.items():
            f.write(f"export {k}={json.dumps(v)}\n")
    os.chmod(shell_path, 0o755)

    # Windows batch env
    os.makedirs(WINDOWS_ENV_DIR, exist_ok=True)
    batch_path = os.path.join(WINDOWS_ENV_DIR, "current.bat")
    with open(batch_path, "w") as f:
        f.write(f"@echo off\nREM Bounce — Current provider: {provider_id}\n\n")
        for k, v in env.items():
            f.write(f"set {k}={v}\n")

    # JSON files
    env_data = {
        "provider_id": provider_id,
        "env": env,
        "updated_at": subprocess.getoutput("date -Iseconds")
    }
    for p in [os.path.join(CONFIG_DIR, "current.env"), 
              os.path.join(WINDOWS_ENV_DIR, "current.env")]:
        with open(p, "w") as f:
            json.dump(env_data, f, indent=2, ensure_ascii=False)

    return env

def do_switch(provider_id):
    """Switch to a provider and return result."""
    config = load_config()
    provider = next((p for p in config["providers"] if p["id"] == provider_id), None)
    if not provider:
        return {"ok": False, "error": f"Provider '{provider_id}' not found"}
    
    config["active_provider"] = provider_id
    save_config(config)
    env = write_env_files(config, provider_id)
    
    return {
        "ok": True,
        "provider": {
            "id": provider["id"],
            "name": provider["name"],
            "type": provider["type"],
            "api_format": provider["api_format"],
            "api_base": provider["api_base"],
            "models": provider.get("models", {}),
        },
        "env": env
    }

def get_status():
    """Get full status as dict."""
    config = load_config()
    active_id = config.get("active_provider", "NONE")
    provider = next((p for p in config["providers"] if p["id"] == active_id), None)
    env = get_env_for_provider(config, active_id) if provider else {}
    return {
        "active_provider": active_id,
        "active_name": provider["name"] if provider else "NONE",
        "providers": [
            {
                "id": p["id"],
                "name": p["name"],
                "type": p["type"],
                "api_format": p["api_format"],
                "api_base": p["api_base"],
                "models": list(set(p.get("models", {}).values())),
                "is_active": p["id"] == active_id,
                "notes": p.get("notes", ""),
            }
            for p in config["providers"]
        ],
        "env": env,
    }

def test_provider(provider_id):
    """Test a provider with a simple API call."""
    config = load_config()
    provider = next((p for p in config["providers"] if p["id"] == provider_id), None)
    if not provider:
        return {"ok": False, "error": "Provider not found"}
    
    api_base = provider["api_base"]
    api_key = provider.get("api_key", "")
    api_format = provider["api_format"]
    models = provider.get("models", {})
    model = models.get("default", "")
    
    if api_format == "openai":
        url = api_base.rstrip("/") + "/chat/completions"
        headers = {
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json"
        }
        data = {"model": model, "messages": [{"role": "user", "content": "hi"}], "max_tokens": 5}
    elif api_format == "anthropic":
        url = api_base.rstrip("/") + "/v1/messages" if "v1/messages" not in api_base else api_base
        headers = {
            "x-api-key": api_key,
            "anthropic-version": "2023-06-01",
            "Content-Type": "application/json"
        }
        data = {"model": model, "max_tokens": 5, "messages": [{"role": "user", "content": "hi"}]}
    else:
        return {"ok": False, "error": f"Unknown format: {api_format}"}
    
    try:
        import requests
        resp = requests.post(url, headers=headers, json=data, timeout=10)
        if resp.status_code == 200:
            return {"ok": True, "status": 200, "response": resp.text[:200]}
        else:
            return {"ok": False, "status": resp.status_code, "error": resp.text[:200]}
    except ImportError:
        return {"ok": False, "error": "requests not installed"}
    except Exception as e:
        return {"ok": False, "error": str(e)}


