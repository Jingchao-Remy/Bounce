#!/usr/bin/env python3
"""
Bounce — Unified model router for all your AI tools.

Usage:
  bounce list                  # List all providers
  bounce use <id>              # Switch to a provider
  bounce status                # Show current provider
  bounce env                   # Show current env vars for Claude Code
  bounce doctor                # Check all tool configs
"""

import os
import sys
import json
import subprocess
import shlex

CONFIG_DIR = os.path.expanduser("~/.bounce")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
CURRENT_ENV_PATH = os.path.join(CONFIG_DIR, "current.env")
# WSL <-> Windows integration
def _get_win_user():
    """Get the current Windows username for WSL path resolution."""
    users_dir = "/mnt/c/Users"
    if os.path.exists(users_dir):
        for u in sorted(os.listdir(users_dir)):
            if u not in (".", "..", "All Users", "Default", "Default User", "Public"):
                full = os.path.join(users_dir, u)
                if os.path.isdir(full) and not os.path.islink(full):
                    return full
    return os.path.expanduser("~")
WIN_USER_HOME = _get_win_user()
WINDOWS_ENV_DIR = os.path.join(WIN_USER_HOME, ".bounce")


def load_config():
    if not os.path.exists(CONFIG_PATH):
        print(f"❌ Config not found: {CONFIG_PATH}")
        print("   Create it first.")
        sys.exit(1)
    with open(CONFIG_PATH) as f:
        return json.load(f)


def resolve(config, provider_id, key_path):
    """Resolve a dot-separated path like 'models.default' from a provider."""
    provider = None
    for p in config["providers"]:
        if p["id"] == provider_id:
            provider = p
            break
    if not provider:
        return None
    parts = key_path.split(".")
    val = provider
    for part in parts:
        if isinstance(val, dict):
            val = val.get(part)
        else:
            return None
    return val


def get_env_for_provider(config, provider_id):
    """Build env var dict for Claude Code from a provider config."""
    env = {}
    tool = config["tools"]["claude_code"]
    for env_var, key_path in tool["env_map"].items():
        val = resolve(config, provider_id, key_path)
        if val:
            env[env_var] = str(val)
    return env


def write_env_files(config, provider_id):
    """Write env files for both WSL and Windows."""
    env = get_env_for_provider(config, provider_id)
    
    # WSL shell env
    shell_path = os.path.join(CONFIG_DIR, "current.sh")
    with open(shell_path, "w") as f:
        f.write(f"# Bounce — Current provider: {provider_id}\n")
        f.write(f"# Generated by `bounce use {provider_id}`\n\n")
        for k, v in env.items():
            f.write(f"export {k}={shlex.quote(v)}\n")
        f.write("\n# Source this in your shell:\n")
        f.write(f"# source {shell_path}\n")
    os.chmod(shell_path, 0o755)

    # Windows batch env (for Claude Code)
    os.makedirs(WINDOWS_ENV_DIR, exist_ok=True)
    batch_path = os.path.join(WINDOWS_ENV_DIR, "current.bat")
    with open(batch_path, "w") as f:
        f.write(f"@echo off\n")
        f.write(f"REM Bounce — Current provider: {provider_id}\n")
        f.write(f"REM Generated by `bounce use {provider_id}`\n\n")
        for k, v in env.items():
            f.write(f"set {k}={v}\n")
        f.write(f"\nREM Run this before launching Claude Code:\n")
        f.write(f"REM call {batch_path}\n")

    # JSON env file (for programmatic use)
    json_path = os.path.join(CONFIG_DIR, "current.env")
    with open(json_path, "w") as f:
        json.dump({
            "provider_id": provider_id,
            "env": env,
            "updated_at": subprocess.getoutput("date -Iseconds")
        }, f, indent=2, ensure_ascii=False)

    json_win_path = os.path.join(WINDOWS_ENV_DIR, "current.env")
    with open(json_win_path, "w") as f:
        json.dump({
            "provider_id": provider_id,
            "env": env,
            "updated_at": subprocess.getoutput("date -Iseconds")
        }, f, indent=2, ensure_ascii=False)

    return env


def update_config_file(config, provider_id):
    """Update the active provider in config.json."""
    config["active_provider"] = provider_id
    with open(CONFIG_PATH, "w") as f:
        json.dump(config, f, indent=2, ensure_ascii=False)


def update_continue_config(provider):
    """Update Continue config.json on Windows if provider has OpenAI-compatible info."""
    continue_path = f"{WIN_USER_HOME}/.continue/config.json"
    if not os.path.exists(continue_path):
        print(f"   ⚠ Continue config not found: {continue_path}")
        return False
    
    # For now, just read and report
    try:
        with open(continue_path) as f:
            cont = json.load(f)
        models = cont.get("models", [])
        print(f"   ℹ Continue has {len(models)} models configured (read-only in Phase 1)")
        return True
    except Exception as e:
        print(f"   ❌ Continue: {e}")
        return False


def cmd_list(config):
    """List all providers."""
    active = config.get("active_provider", "")
    print(f"\n{'='*55}")
    print(f"  Bounce — Providers")
    print(f"{'='*55}")
    for p in config["providers"]:
        marker = "🟢" if p["id"] == active else "⚪"
        fmt = p["api_format"].upper()
        loc = "☁️" if p["type"] == "cloud" else "🖥️"
        models = list(p.get("models", {}).values())
        models_str = ", ".join(sorted(set(models)))
        print(f"  {marker} {p['id']:25s} {loc} {fmt:10s} {models_str[:40]}")
    print()


def cmd_status(config):
    """Show current provider status."""
    active_id = config.get("active_provider", "NONE")
    provider = None
    for p in config["providers"]:
        if p["id"] == active_id:
            provider = p
            break
    
    print(f"\n{'='*55}")
    print(f"  Bounce — Status")
    print(f"{'='*55}")
    
    if provider:
        print(f"  🟢 当前: {provider['name']} ({provider['id']})")
        print(f"     类型: {provider['type']}")
        print(f"     格式: {provider['api_format'].upper()}")
        print(f"     接口: {provider['api_base']}")
        models = provider.get("models", {})
        print(f"     模型: default={models.get('default','?')}")
        if 'haiku' in models:
            print(f"           haiku={models['haiku']}  sonnet={models['sonnet']}  opus={models['opus']}")
        print(f"     备注: {provider.get('notes','')}")
    else:
        print(f"  ⚠️ 无效的 active_provider: {active_id}")
    
    # Show Claude Code env vars
    print(f"\n  🔧 Claude Code 环境变量:")
    env = get_env_for_provider(config, active_id)
    if env:
        for k, v in env.items():
            print(f"     {k}={v}")
    else:
        print(f"     (none)")
    
    print()


def cmd_use(config, provider_id):
    """Switch to a provider."""
    # Validate
    provider = None
    for p in config["providers"]:
        if p["id"] == provider_id:
            provider = p
            break
    
    if not provider:
        print(f"❌ 未找到 provider: {provider_id}")
        print(f"   可用: {', '.join(p['id'] for p in config['providers'])}")
        sys.exit(1)
    
    print(f"\n{'='*55}")
    print(f"  🔄 切换至: {provider['name']} ({provider['id']})")
    print(f"{'='*55}")
    
    # Step 1: Write env files
    print(f"\n  📝 写入环境变量...")
    env = write_env_files(config, provider_id)
    print(f"     ✅ WSL:   {CONFIG_DIR}/current.sh")
    print(f"     ✅ Win:   {WINDOWS_ENV_DIR}/current.bat")
    print(f"     ✅ Env:   {CONFIG_DIR}/current.env")
    
    # Step 2: Update config
    print(f"\n  📝 更新配置...")
    update_config_file(config, provider_id)
    print(f"     ✅ config.json active_provider = {provider_id}")
    
    # Step 3: Tell user what to do
    print(f"\n  🚀 切换完成！")
    print(f"\n  ⚡ 要使用 Claude Code，请在 Windows 终端执行:")
    print(f"     call {WINDOWS_ENV_DIR}\\current.bat")
    print(f"     claude")
    print(f"\n  ⚡ 或在 WSL 中:")
    print(f"     source ~/.bounce/current.sh")
    print(f"     claude")
    
    print()


def cmd_env(config):
    """Show current env vars."""
    active_id = config.get("active_provider", "")
    env = get_env_for_provider(config, active_id)
    if not env:
        print("⚠️  No env vars for current provider.")
        return
    print("\n# Claude Code env vars for current provider:")
    for k, v in env.items():
        print(f"export {k}={shlex.quote(v)}")
    print()


def cmd_doctor(config):
    """Check all tool configurations."""
    print(f"\n{'='*55}")
    print(f"  🩺 Bounce — Doctor")
    print(f"{'='*55}")
    
    # Check config
    print(f"\n  📋 配置:")
    print(f"     ✅ {CONFIG_PATH} ({len(config['providers'])} providers)")
    
    # Check each tool config
    print(f"\n  🔧 工具:")
    
    # Continue (Windows)
    cont_path = f"{WIN_USER_HOME}/.continue/config.json"
    if os.path.exists(cont_path):
        print(f"     ✅ Continue (Win): {cont_path}")
    else:
        print(f"     ❌ Continue (Win): 不存在")
    
    # LiteLLM
    litellm_path = "/tmp/litellm_config.yaml"
    if os.path.exists(litellm_path):
        print(f"     ✅ LiteLLM: {litellm_path}")
    else:
        print(f"     ❌ LiteLLM: 不存在")
    
    # qwen-cli
    qwen_path = os.path.expanduser("~/.config/qwen-cli/config.json")
    if os.path.exists(qwen_path):
        print(f"     ✅ qwen-cli: {qwen_path}")
    else:
        print(f"     ⚠️ qwen-cli: 未配置")
    
    # CC Switch
    cc_path = f"{WIN_USER_HOME}/.cc-switch/cc-switch.db"
    if os.path.exists(cc_path):
        print(f"     ✅ CC Switch DB: {cc_path}")
    else:
        print(f"     ⚠️ CC Switch: 不存在")
    
    # Check env files
    print(f"\n  🌐 环境文件:")
    for fn, label in [("current.sh", "WSL"), ("current.env", "JSON"), (f"{WINDOWS_ENV_DIR}/current.bat", "Win Bat"), (f"{WINDOWS_ENV_DIR}/current.env", "Win JSON")]:
        fpath = os.path.join(CONFIG_DIR, fn) if not fn.startswith(WINDOWS_ENV_DIR) else fn
        if os.path.exists(fpath):
            print(f"     ✅ {label}: {fpath}")
        else:
            print(f"     ⚪ {label}: 不存在")
    
    print()


def cmd_install_local(config):
    """Install a tiny local AI model (Qwen2.5-0.5B) for offline use."""
    print(f"\n{'='*55}")
    print(f"  🔧 Bounce — Install Local AI Model")
    print(f"{'='*55}")
    print(f"\n  📦 Qwen2.5-0.5B-Instruct-Q4_K_M.gguf (~350MB)")
    print(f"  ⚡ Runs entirely on CPU, no API key needed.")
    print(f"  🧠 Real AI inference via llama-cpp-python.\n")

    # Run the installer function from the gateway script via subprocess
    gateway_path = os.path.expanduser("~/.local/bin/bounce-gateway")
    if not os.path.exists(gateway_path):
        print("❌ Gateway script not found. Reinstall bounce.")
        return

    script = f"""
import sys, os
sys.path.insert(0, os.path.dirname('{gateway_path}'))
exec(open('{gateway_path}').read().split('if __name__ ==')[0])
_run_install_local()
"""
    ret = subprocess.run([sys.executable, "-c", script])
    if ret.returncode != 0:
        print(f"\n  ❌ Installation exited with code {ret.returncode}")


def cmd_gateway(config, argv):
    """Gateway subcommand: start/stop/status."""
    if len(argv) < 1:
        print("用法:")
        print("  bounce gateway start          启动网关 (:3001)")
        print("  bounce gateway stop           停止网关")
        print("  bounce gateway status         查看网关状态")
        return
    
    sub = argv[0]
    if sub == "start":
        pid_file = os.path.join(CONFIG_DIR, "gateway.pid")
        if os.path.exists(pid_file):
            print(f"⚠️  Gateway 已在运行 (PID {open(pid_file).read().strip()})")
            print(f"   重启请先: bounce gateway stop")
            return
        print("⚡ 启动 Bounce Gateway: http://localhost:3001")
        import subprocess as sp
        proc = sp.Popen(
            ["/usr/bin/python3", os.path.expanduser("~/.local/bin/bounce-gateway"),
             "--daemon", "--port", str(config.get("gateway", {}).get("port", 3001))],
        )
        # Give it a moment to start
        import time as _t
        _t.sleep(1)
        # Check if it's running
        try:
            import urllib.request
            urllib.request.urlopen("http://localhost:3001/health", timeout=2)
            print("   ✅ Gateway 已就绪")
        except:
            print("   ⚠️  Gateway 启动中，稍后检查 health 端点")
    elif sub == "stop":
        pid_file = os.path.join(CONFIG_DIR, "gateway.pid")
        if not os.path.exists(pid_file):
            print("⚠️  未找到 gateway.pid，尝试 pkill")
            os.system("pkill -f bounce-gateway 2>/dev/null")
            print("   ✅ Gateway 已停止")
            return
        pid = open(pid_file).read().strip()
        try:
            os.kill(int(pid), 15)
            os.remove(pid_file)
            print(f"   ✅ Gateway (PID {pid}) 已停止")
        except ProcessLookupError:
            os.remove(pid_file)
            print(f"   ✅ Gateway 已停止 (进程不存在)")
    elif sub == "status":
        pid_file = os.path.join(CONFIG_DIR, "gateway.pid")
        if os.path.exists(pid_file):
            pid = open(pid_file).read().strip()
            try:
                os.kill(int(pid), 0)
                print(f"   🟢 Gateway 运行中 (PID {pid})")
                print(f"      端点: http://localhost:{config.get('gateway', {}).get('port', 3001)}")
            except:
                print(f"   ⚪ Gateway 未运行 (PID 文件残留)")
        else:
            print(f"   ⚪ Gateway 未运行")
    else:
        print(f"❌ 未知子命令: {sub}")
        print("   可用: start, stop, status")


def cmd_provider(config, argv):
    """Provider subcommand: add/list."""
    if len(argv) < 1:
        print("用法:")
        print("  bounce provider list                   列出已配置的 Gateway Provider")
        print("  bounce provider add <template> --key   从模板添加 PROVIDER")
        print("  bounce provider templates              列出可用模板")
        return
    
    sub = argv[0]
    
    if sub == "list":
        gw_providers = [p for p in config.get("providers", []) if p.get("gateway", False)]
        if not gw_providers:
            print("   ⚪ 未配置 Gateway Provider")
            print("     使用: bounce provider add <template_id> --key <key>")
            return
        print(f"\n{'='*55}")
        print(f"  Gateway Providers ({len(gw_providers)} 个)")
        print(f"{'='*55}")
        for p in gw_providers:
            tier = p.get("tier", "?")
            name = p.get("name", p["id"])
            api_key = p.get("api_key", "")
            key_display = api_key[:8] + "..." if api_key and len(api_key) > 10 else "(env)"
            print(f"  [{tier:15s}] {name:25s} key={key_display}")
        print()
    
    elif sub == "templates":
        tpl_path = os.path.expanduser("~/.bounce/templates.json")
        if not os.path.exists(tpl_path):
            print("❌ 模板文件不存在")
            return
        with open(tpl_path) as f:
            tpls = json.load(f)
        tiers = tpls.get("tiers", [])
        providers = tpls.get("providers", [])
        print(f"\n{'='*55}")
        print(f"  Provider 模板库")
        print(f"{'='*55}")
        for t in tiers:
            tier_provs = [p for p in providers if p.get("tier") == t["id"]]
            if tier_provs:
                print(f"\n  {t['icon']} {t['name']} (Tier {t['order']}):")
                for p in tier_provs:
                    print(f"    {p['id']:25s} → {p['api_base']}")
        print(f"\n  添加: bounce provider add <template_id> --key <key>")
        print()
    
    elif sub == "add":
        if len(argv) < 2:
            print("❌ 用法: bounce provider add <template_id> --key <api_key>")
            print("   示例: bounce provider add deepseek-cp --key sk-xxxx")
            return
        
        template_id = argv[1]
        api_key = ""
        for i, a in enumerate(argv):
            if a == "--key" and i + 1 < len(argv):
                api_key = argv[i + 1]
                break
        
        # Load template
        tpl_path = os.path.expanduser("~/.bounce/templates.json")
        if not os.path.exists(tpl_path):
            print("❌ 模板文件不存在")
            return
        with open(tpl_path) as f:
            tpls = json.load(f)
        
        template = None
        for p in tpls.get("providers", []):
            if p["id"] == template_id:
                template = p
                break
        
        if not template:
            print(f"❌ 未找到模板: {template_id}")
            print(f"   查看可用模板: bounce provider templates")
            return
        
        # Add to config
        new_provider = {
            "id": template["id"],
            "name": template["name"],
            "type": "cloud" if template["tier"] in ("coding_plan", "payg", "free") else "local",
            "tier": template["tier"],
            "gateway": True,
            "template_id": template["id"],
            "api_base": template["api_base"],
            "models": template["models"],
            "timeout": template["timeout"],
        }
        if api_key:
            new_provider["api_key"] = api_key
        
        # Check for duplicate
        for existing in config.get("providers", []):
            if existing["id"] == new_provider["id"]:
                # Update instead of adding
                existing.update(new_provider)
                with open(CONFIG_PATH, "w") as f:
                    json.dump(config, f, indent=2, ensure_ascii=False)
                print(f"   ✅ 已更新 PROVIDER: {template['name']}")
                return
        
        config.setdefault("providers", []).append(new_provider)
        with open(CONFIG_PATH, "w") as f:
            json.dump(config, f, indent=2, ensure_ascii=False)
        print(f"   ✅ 已添加 PROVIDER: {template['name']}")
        print(f"   Tier: {template['tier']} | Endpoint: {template['api_base']}")
        print(f"   启动网关: bounce gateway start")
    
    else:
        print(f"❌ 未知子命令: {sub}")


def main():
    config = load_config()
    
    if len(sys.argv) < 2:
        print("Bounce — 统一模型路由工具")
        print()
        print("用法:")
        print("  bounce list                   列出所有 Provider")
        print("  bounce use <id>               切换至指定 Provider")
        print("  bounce status                 查看当前 Provider")
        print("  bounce env                    显示当前环境变量")
        print("  bounce doctor                 检查所有工具配置")
        print("  bounce panel                  Web 管理面板")
        print("  bounce install-local           Install tiny local AI model (CPU)")
        print("  bounce gateway <start|stop|status>   failover 网关")
        print("  bounce provider <add|list|templates>  PROVIDER 管理")
        print()
        return
    
    cmd = sys.argv[1]
    
    if cmd == "list":
        cmd_list(config)
    elif cmd == "status":
        cmd_status(config)
    elif cmd == "use":
        if len(sys.argv) < 3:
            print("❌ 用法: bounce use <provider_id>")
            print(f"   可用: {', '.join(p['id'] for p in config['providers'])}")
            sys.exit(1)
        cmd_use(config, sys.argv[2])
    elif cmd == "env":
        cmd_env(config)
    elif cmd == "doctor":
        cmd_doctor(config)
    elif cmd == "panel":
        print("⚡ 启动 Bounce Panel: http://localhost:3000")
        os.execvp("/usr/bin/python3", ["python3", os.path.expanduser("~/.local/bin/bounce-panel"), "--port", "3000"])
    elif cmd == "gateway":
        cmd_gateway(config, sys.argv[2:])
    elif cmd == "install-local":
        cmd_install_local(config)
    elif cmd == "provider":
        cmd_provider(config, sys.argv[2:])


if __name__ == "__main__":
    main()